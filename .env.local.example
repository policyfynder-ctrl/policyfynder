# Supabase — get these from your project dashboard: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Communication providers (Milestone 13)
# ------------------------------------------------------------
# DRY-RUN BY DEFAULT. Leave COMMUNICATIONS_DRY_RUN unset or 'true' and NO live
# email / WhatsApp / SMS is ever sent — the dispatcher simulates sends and records
# them in delivery_logs. Set it to 'false' (and fill the creds below) only when you
# are ready for real delivery. See docs/communication-providers.md for setup.
COMMUNICATIONS_DRY_RUN=true

# Shared secret the Vercel Cron job sends as `Authorization: Bearer <secret>` to
# /api/cron/dispatch. Required — the route refuses to run without it.
CRON_SECRET=

# --- Microsoft Graph (email) — Azure app registration, application Mail.Send ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=noreply@yourdomain.com

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
